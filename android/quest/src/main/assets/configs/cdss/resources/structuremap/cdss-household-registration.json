{
  "resourceType": "StructureMap",
  "id": "cdss-household-registration",
  "text": {
    "status": "additional",
    "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><pre>map &quot;https://fhir.opensrp.io/cdss/StructureMap/cdss-household-registration&quot; = 'CdssHouseholdRegistration'\n\nuses &quot;http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse&quot; as source\nuses &quot;http://hl7.org/fhir/StructureDefinition/Bundle&quot; as target\nuses &quot;http://hl7.org/fhir/StructureDefinition/Group&quot; as target\n\n// Produces the household Group that householdRegister queries: type 'person' and\n// code SNOMED 35359004. Members are added later by the add-member flow, which\n// relies on QuestionnaireConfig.groupResource rather than on this map.\ngroup CdssHouseholdRegistration(source src : QuestionnaireResponse, target bundle: Bundle) {\n    src -&gt; bundle.id = uuid() &quot;r_bun_id&quot;;\n    src -&gt; bundle.type = 'collection' &quot;r_bun_type&quot;;\n    src -&gt; bundle.entry as entry, entry.resource = create('Group') as group then\n        ExtractGroup(src, group) &quot;r_bun_entries&quot;;\n}\n\ngroup ExtractGroup(source src : QuestionnaireResponse, target group : Group) {\n    src -&gt; group.id = uuid() &quot;r_g_id&quot;;\n    src -&gt; group.active = true &quot;r_g_active&quot;;\n    src -&gt; group.type = 'person' &quot;r_g_type&quot;;\n    src -&gt; group.actual = true &quot;r_g_actual&quot;;\n\n    src -&gt; group.name = evaluate(src, $this.item.where(linkId = 'hh-name').answer.value) &quot;r_g_name&quot;;\n\n    // Household number. The register card reads Group.identifier[0].value.\n    src.item as item where(linkId = 'hh-number' and answer.exists()) -&gt;\n      group.identifier = create('Identifier') as iden then {\n        src -&gt; iden.use = 'official' &quot;r_g_id_use&quot;;\n        src -&gt; iden.system = 'https://fhir.opensrp.io/cdss/identifier/household-number' &quot;r_g_id_sys&quot;;\n        src -&gt; iden.value = evaluate(item, $this.answer.value) &quot;r_g_id_val&quot;;\n      } &quot;r_g_iden&quot;;\n\n    // Village. Emitted first so it lands in Group.characteristic[0], which is where\n    // the register and profile read familyVillage from.\n    src.item as village where(linkId = 'hh-village' and answer.exists()) -&gt;\n      group.characteristic = create('Group_Characteristic') as characteristic then {\n        village -&gt; characteristic.code = create('CodeableConcept') as villageCode then {\n          src -&gt; villageCode.coding = c(&quot;http://ona.io/codes&quot;, &quot;hh_village&quot;) as coding then {\n            src -&gt; coding.display = 'Household Village' &quot;r_g_ch_disp&quot;;\n          } &quot;r_g_ch_coding&quot;;\n          src -&gt; villageCode.text = evaluate(village, $this.answer.value) &quot;r_g_ch_text&quot;;\n        } &quot;r_g_ch_code&quot;;\n        village -&gt; characteristic.value = create('CodeableConcept') as villageValue then {\n          src -&gt; villageValue.text = evaluate(village, $this.answer.value) &quot;r_g_ch_val_text&quot;;\n        } &quot;r_g_ch_value&quot;;\n        src -&gt; characteristic.exclude = false &quot;r_g_ch_exclude&quot;;\n      } &quot;r_g_characteristic&quot;;\n\n    src -&gt; group.code = create('CodeableConcept') as concept then ExtractHouseholdCode(src, concept) &quot;r_g_code&quot;;\n}\n\ngroup ExtractHouseholdCode(source src : QuestionnaireResponse, target concept : CodeableConcept) {\n    src -&gt; concept.coding = c(&quot;https://www.snomed.org&quot;, &quot;35359004&quot;) as coding then {\n        src -&gt; coding.display = 'Household' &quot;r_g_code_disp&quot;;\n    } &quot;r_g_code_coding&quot;;\n    src -&gt; concept.text = 'Household' &quot;r_g_code_text&quot;;\n}</pre></div>"
  },
