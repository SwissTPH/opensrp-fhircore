{
  "resourceType": "StructureMap",
  "id": "cdss-client-registration",
  "text": {
    "status": "additional",
    "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\"><pre>map &quot;https://fhir.opensrp.io/cdss/StructureMap/cdss-client-registration&quot; = 'CdssClientRegistration'\n\nuses &quot;http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse&quot; as source\nuses &quot;http://hl7.org/fhir/StructureDefinition/Bundle&quot; as target\nuses &quot;http://hl7.org/fhir/StructureDefinition/Patient&quot; as target\n\n// Patient only. RelatedPerson links are created by RelatedPersonLinkService\n// after the native add-related flow, not by this map.\ngroup CdssClientRegistration(source src : QuestionnaireResponse, target bundle: Bundle) {\n    src -&gt; bundle.id = uuid() &quot;r_bun_id&quot;;\n    src -&gt; bundle.type = 'collection' &quot;r_bun_type&quot;;\n    src -&gt; bundle.entry as entry, entry.resource = create('Patient') as patient then\n        ExtractPatient(src, patient) &quot;r_bun_entries&quot;;\n}\n\ngroup ExtractPatient(source src : QuestionnaireResponse, target patient : Patient) {\n    src -&gt; patient.id = uuid() &quot;r_p_id&quot;;\n    src -&gt; patient.active = true &quot;r_p_active&quot;;\n\n    // Name (first / middle / family)\n    src.item as item where(linkId = 'Ccc.A.DE04' or linkId = 'Ccc.A.DE05' or linkId = 'Ccc.A.DE06') -&gt;\n      patient.name = create('HumanName') as patientName then {\n        src -&gt; patientName.use = 'official' &quot;r_p_n_use&quot;;\n        src -&gt; patientName.given = evaluate(src, $this.item.where(linkId = 'Ccc.A.DE04').answer.value) &quot;r_p_gname&quot;;\n        src -&gt; patientName.given = evaluate(src, $this.item.where(linkId = 'Ccc.A.DE05').answer.value) &quot;r_p_mname&quot;;\n        src -&gt; patientName.family = evaluate(src, $this.item.where(linkId = 'Ccc.A.DE06').answer.value) &quot;r_p_fname&quot;;\n      } &quot;r_p_name&quot;;\n\n    // Consolidated DOB\n    src.item as item where(linkId = 'Ccc.A.DE08' and answer.exists()) -&gt;\n      patient.birthDate = evaluate(item, $this.answer.value) &quot;r_p_dob&quot;;\n\n    // National ID\n    src.item as item where(linkId = 'Ccc.A.DE01' and answer.exists()) -&gt;\n      patient.identifier = create('Identifier') as iden then {\n        src -&gt; iden.use = 'official' &quot;r_p_id_use&quot;;\n        src -&gt; iden.system = 'https://fhir.opensrp.io/cdss/identifier/national-id' &quot;r_p_id_sys&quot;;\n        src -&gt; iden.value = evaluate(item, $this.answer.value) &quot;r_p_id_val&quot;;\n      } &quot;r_p_iden&quot;;\n\n    // Sex (choice codes from questionnaire)\n    src.item as sex where(linkId = 'Ccc.A.DE16' and answer.value.code = 'Ccc.A.DE17') -&gt;\n      patient.gender = 'female' &quot;r_p_female&quot;;\n    src.item as sex where(linkId = 'Ccc.A.DE16' and answer.value.code = 'Ccc.A.DE18') -&gt;\n      patient.gender = 'male' &quot;r_p_male&quot;;\n    src.item as sex where(linkId = 'Ccc.A.DE16' and answer.value.code = 'Ccc.A.DE19') -&gt;\n      patient.gender = 'unknown' &quot;r_p_unknown&quot;;\n}\n</pre></div>"
  },
