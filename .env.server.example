# Server POC — public IP with Let's Encrypt IP certificates (shortlived).
# https://letsencrypt.org/2026/01/15/6day-and-ip-general-availability

PUBLIC_IP=194.182.171.88
HTTP_PORT=80
HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8088

# ACME (required for LE). Use a real mailbox you control.
ACME_EMAIL=admin@example.com
# Optional staging while testing (avoids prod rate limits):
# Uncomment caServer in conf/traefik/traefik.yml for staging.

# Public HTTPS origin (must match PUBLIC_IP for IP certs)
KEYCLOAK_PUBLIC_URL=https://194.182.171.88
TOKEN_ISSUER=https://194.182.171.88/realms/opensrp

# GlitchTip — public HTTPS (LE-trusted → no Java truststore for HAPI/gateway)
GLITCHTIP_DOMAIN=https://194.182.171.88/logs
GLITCHTIP_ANDROID_HOST=https://194.182.171.88/logs
# Leave empty to reuse GLITCHTIP_DOMAIN for server-side Sentry SDKs
GLITCHTIP_INTERNAL_HOST=
GLITCHTIP_CSRF_TRUSTED_ORIGINS=http://194.182.171.88,https://194.182.171.88

HAPI_DB_PASSWORD=CHANGEME
KEYCLOAK_DB_PASSWORD=CHANGEME
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEME
GLITCHTIP_DB_PASSWORD=CHANGEME
GLITCHTIP_SECRET_KEY=CHANGEME
GLITCHTIP_SUPERUSER_EMAIL=admin@opensrp.local
GLITCHTIP_SUPERUSER_PASSWORD=CHANGEME
ENABLE_ORGANIZATION_CREATION=True
