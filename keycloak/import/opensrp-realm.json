  "clients": [
    {
      "clientId": "fhir-core-client",
      "name": "OpenSRP FHIR Core (Android / local)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "fullScopeAllowed": true,
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email", "basic"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"],
      "protocolMappers": [
        {
          "name": "fhir_core_app_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "fhir_core_app_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "fhir_core_app_id",
            "jsonType.label": "String"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
