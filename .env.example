# Copy to .env and adjust. All values have compose defaults if unset.
#   cp .env.example .env

# --- Public edge (Traefik) ---
HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8088
TRAEFIK_DASHBOARD=true
TRAEFIK_LOG_LEVEL=INFO
# Public origin used for Keycloak issuer + GlitchTip (no trailing slash)
# KEYCLOAK_PUBLIC_URL=http://localhost
# TOKEN_ISSUER=http://localhost/realms/opensrp

# --- HAPI Postgres ---
HAPI_DB_NAME=hapi
HAPI_DB_USER=hapi
HAPI_DB_PASSWORD=CHANGEME

# --- Keycloak Postgres ---
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGEME

# --- Keycloak admin ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEME
KEYCLOAK_CLIENT_SECRET=CHANGEME
KEYCLOAK_HOSTNAME=localhost

# --- GlitchTip (behind Traefik at /logs) ---
GLITCHTIP_DB_NAME=glitchtip
GLITCHTIP_DB_USER=glitchtip
GLITCHTIP_DB_PASSWORD=CHANGEME
GLITCHTIP_SECRET_KEY=CHANGEME
GLITCHTIP_DOMAIN=http://localhost/logs
GLITCHTIP_ANDROID_HOST=http://10.0.2.2/logs
GLITCHTIP_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_SUPERUSER_EMAIL=admin@opensrp.local
GLITCHTIP_SUPERUSER_PASSWORD=CHANGEME
# After up: SENTRY_DSN=$(cat conf/glitchtip/public-dsn.android.txt)
